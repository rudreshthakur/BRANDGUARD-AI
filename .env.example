# ---- Backend (FastAPI) ----
# Database: SQLite by default; use PostgreSQL in production (Render/Supabase connection string).
DATABASE_URL=sqlite:///./brandguard.db
# DATABASE_URL=postgresql://user:password@host:5432/brandguard

# Optional AI contextual analysis. Leave provider as "none" to run deterministic + retrieval checks only.
BRANDGUARD_LLM_PROVIDER=none          # none | anthropic | openai
BRANDGUARD_LLM_API_KEY=               # server-side secret, never exposed to the browser
BRANDGUARD_LLM_MODEL=                 # e.g. claude-haiku-5-5 or gpt-4o-mini (provider default if empty)
BRANDGUARD_LLM_BASE_URL=              # optional: custom/compatible endpoint
BRANDGUARD_LLM_TIMEOUT=25

# Limits and demo behaviour
BRANDGUARD_MAX_UPLOAD_MB=10
BRANDGUARD_MAX_CONTENT_CHARS=20000
BRANDGUARD_SANDBOX_TTL_HOURS=72       # demo workspaces are deleted after this many hours
BRANDGUARD_DEMO_RATE_LIMIT=30         # demo workspaces per IP per hour
# Only needed when the frontend is hosted on a different origin (e.g. Vercel + Render)
BRANDGUARD_CORS_ORIGINS=http://localhost:5173

# ---- Frontend (only for split hosting, e.g. Vercel) ----
# VITE_API_BASE=https://brandguard-ai.onrender.com
